@layer(time=0, thread=0, coord=(0))
int32 rvdl_main() {
    double b = boltzmann2(1.0, 0.0, 0.0);   // 老朋友内建，满分答案 0.5
    double e = moe_virtual_experts(5.0);     // 新朋友内建，期待 32.0 的全家福
    int32 r = 0;
    if (b > 0.4 && b < 0.6) { r = r + 10; }   // 玻尔兹曼就在附近 → +10，稳
    if (e > 31.0)          { r = r + 100; }   // 专家到齐 → +100，棒
    return r;                                  // 期待 110，双科满分！
}