; --- 多维标签函数执行拓扑（@layer）调度 ABI ---
declare i32 @rvdl_runtime_run_topology(i8*)
; --- 并发线程（spawn）ABI ---
declare void @rvdl_spawn(i8*, i8*)


define i32 @rvdl_main() {
entry:
 %b_ptr_1 = alloca double
 %e_ptr_2 = alloca double
 %r_ptr_3 = alloca i32
 %logic_ptr_7 = alloca i1
 %1 = call double @rvdl_boltzmann2(double 1.0, double 0.0, double 0.0)
 store double %1, double* %b_ptr_1
 %2 = call double @rvdl_moe_virtual_experts(double 5.0)
 store double %2, double* %e_ptr_2
 store i32 0, i32* %r_ptr_3
 %3 = load double, double* %b_ptr_1
 %4 = fcmp ogt double %3, 0.4
 br i1 %4, label %logic_eval_10, label %logic_short_9

logic_short_9:
 store i1 false, i1* %logic_ptr_7
 br label %logic_end_8

logic_eval_10:
 %5 = load double, double* %b_ptr_1
 %6 = fcmp olt double %5, 0.6
 store i1 %6, i1* %logic_ptr_7
 br label %logic_end_8

logic_end_8:
 %7 = load i1, i1* %logic_ptr_7
 br i1 %7, label %if_then_4, label %if_after_6

if_then_4:
 %8 = load i32, i32* %r_ptr_3
 %9 = add i32 %8, 10
 store i32 %9, i32* %r_ptr_3
 br label %if_after_6

if_after_6:
 %10 = load double, double* %e_ptr_2
 %11 = fcmp ogt double %10, 31.0
 br i1 %11, label %if_then_11, label %if_after_13

if_then_11:
 %12 = load i32, i32* %r_ptr_3
 %13 = add i32 %12, 100
 store i32 %13, i32* %r_ptr_3
 br label %if_after_13

if_after_13:
 %14 = load i32, i32* %r_ptr_3
 ret i32 %14
}
; --- 多维标签函数执行拓扑（@layer）---
@rvdl_topology_json = private unnamed_addr constant [186 x i8] c"{\22shape\22:{\22time\22:1,\22thread\22:1,\22coord\22:[1]},\22blocks\22:[{\22name\22:\22rvdl_main\22,\22time\22:0,\22thread\22:0,\22coord\22:[0],\22cost\22:1,\22deadline\22:null}],\22callGraph\22:[],\22shuttleLinks\22:[],\22trackingScopes\22:[]}\00", align 1

define i32 @rvdl_topology_entry() {
entry:
  %0 = call i32 @rvdl_runtime_run_topology(i8* getelementptr inbounds ([186 x i8], [186 x i8]* @rvdl_topology_json, i64 0, i64 0))
  ret i32 %0
}